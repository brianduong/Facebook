# Copy file này thành `.env` rồi điền giá trị thật.
# File `.env` đã nằm trong .gitignore → KHÔNG bị đẩy lên GitHub.
# Cách lấy 2 giá trị dưới đây: xem docs/huong-dan-dang-tu-dong.md

FB_PAGE_ID=
FB_PAGE_TOKEN=

# Ảnh nền thật cho video. Lấy key miễn phí ở https://www.pexels.com/api/
# (đăng ký ~2 phút, 200 lượt/giờ — thừa cho nhịp 1 video/ngày)
PEXELS_API_KEY=
